# Python bytecode, caches, and test coverage
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual environments and local configuration
.venv/
venv/
.build-venv/
.env
.env.*
!.env.example

# Build and distribution byproducts (the versioned VSIX in installers/vscode is intentional)
build/
dist/
*.egg-info/
*.spec
*.vsix.tmp
*.tmp
*.log

# Editor and operating-system noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode-test/
.vscode/*.code-workspace
*.swp
*~
