{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MANA: Run current file",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/mana.py",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
