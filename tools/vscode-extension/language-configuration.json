{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {"open": "(", "close": ")"},
    {"open": "[", "close": "]"},
    {"open": "{", "close": "}"},
    {"open": "\"", "close": "\"", "notIn": ["string", "comment"]},
    {"open": "'", "close": "'", "notIn": ["string", "comment"]}
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(def\\b.*|spldef\\b.*|if\\b.*|elif\\b.*|else\\s*:|while\\b.*|for\\b.*|simul\\s*:|after\\b.*|every\\b.*|when\\b.*|[A-Za-z_][A-Za-z0-9_]*\\s*=\\s*tgset\\s*:?)\\s*:?\\s*$",
    "decreaseIndentPattern": "^\\s*(elif\\b.*|else\\s*:|\\})"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(def\\b.*|spldef\\b.*|if\\b.*|elif\\b.*|else\\s*:|while\\b.*|for\\b.*|simul\\s*:|after\\b.*|every\\b.*|when\\b.*|[A-Za-z_][A-Za-z0-9_]*\\s*=\\s*tgset\\s*:?)\\s*:?\\s*$",
      "action": {"indent": "indent"}
    }
  ]
}
