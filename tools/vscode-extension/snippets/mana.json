{
  "Define element spell template": {
    "prefix": "spell",
    "body": [
      "spldef ${1:e_ball}(element):",
      "    ${2:ball = create element}",
      "    shape(ball, circle)",
      "    heat(ball, 500 K)",
      "    velocity(ball, 300 m/s)",
      "    incant ball"
    ],
    "description": "Define a reusable spell template with one base-element selector"
  },
  "Define empty spell": {
    "prefix": "spell-empty",
    "body": [
      "spldef ${1:future_spell}():",
      "    skip"
    ],
    "description": "Define an empty spell placeholder"
  },
  "Define target profile": {
    "prefix": "tgset",
    "body": [
      "${1:target_name} = tgset:",
      "    hp = ${2:250}",
      "    max_hp = ${3:250}",
      "    defence = ${4:40}",
      "    resist_fire = ${5:0.2}",
      "    distance = ${6:10 m}"
    ],
    "description": "Create a target profile"
  },
  "Trial spell": {
    "prefix": "post",
    "body": [
      "post(${1:spell_name})"
    ],
    "description": "Trial a spell and print its trace"
  },
  "Release spell": {
    "prefix": "release",
    "body": [
      "release(${1:spell_name})"
    ],
    "description": "Execute and commit a spell"
  },
  "Tune operation": {
    "prefix": "tune",
    "body": [
      "tune(${1:spell_name}.${2:velocity}) = ${3:target_name}, ${4:300 m/s}"
    ],
    "description": "Change the second argument of one existing operation on a configured spell instance"
  },
  "Create element": {
    "prefix": "create-element",
    "body": [
      "${1:object_name} = create ${2|Fire,Water,Earth,Air|}"
    ],
    "description": "Create a magical object from a fundamental element"
  },
  "Show value": {
    "prefix": "show",
    "body": [
      "show ${1:value}"
    ],
    "description": "Print a value"
  },
  "Target casting block": {
    "prefix": "cast-target",
    "body": [
      "tgset(${1:npc}):",
      "    ${2:post(fireball)}",
      "    ${3:release(fireball)}"
    ],
    "description": "Select an existing target outside the spell, then preview and/or fire it"
  },
  "Define calculation function": {
    "prefix": "function",
    "body": [
      "def ${1:double}(value):",
      "    incant ${2:value * 2}"
    ],
    "description": "Define a normal calculation/helper function with parameters"
  },
  "Load 2D geometry library": {
    "prefix": "load-2d",
    "body": [
      "load geometry2d"
    ],
    "description": "Load advanced 2D geometry helpers; basic 2D physics is already active"
  },
  "Load 3D vector library": {
    "prefix": "load-3d",
    "body": [
      "load vector3d"
    ],
    "description": "Load optional 3D calculation helpers; this does not enable 3D world physics"
  }
}
