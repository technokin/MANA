# The handler runs when the engine reports a real impact, not when drawings overlap.
load geometry2d

when impact:
    show "The runtime reported an impact."

projectile = create Fire
projectile.collision_radius = 0.2 m
velocity(projectile, geometry2d.direction(1, 0) * 30 m/s)

target = tgset:
    hp = 100
    max_hp = 100
    defence = 0
    pos = geometry2d.point(1 m, 0 m)
    collision_radius = 0.2 m

advance_time(0.1 s, timestep=0.01 s)
show "Target HP:", target.hp
